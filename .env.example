# ============================================================
# Haven — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# URL de l'instance PocketBase principale (gestion users + projets)
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# ---- Identifiants admin PocketBase (pour npm run setup) ----
PB_ADMIN_EMAIL=admin@exemple.com
PB_ADMIN_PASSWORD=votre_mot_de_passe_admin

# ---- Infrastructure VPS (pour le démarrage des instances) ----

# Chemin vers le binaire PocketBase sur le serveur
PB_BINARY_PATH=/usr/local/bin/pocketbase

# Dossier où stocker les données de chaque instance
PB_DATA_DIR=/var/haven/projects

# Interface réseau sur laquelle écouter (0.0.0.0 = toutes)
PB_BIND_HOST=0.0.0.0

# Nom d'hôte public utilisé dans les URLs des projets
PB_PUBLIC_HOST=localhost
