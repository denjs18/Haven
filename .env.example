# ============================================================
# Haven — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs
# ============================================================

# URL publique de PocketBase (IP ou domaine du serveur)
# En local  : http://127.0.0.1:8090
# En prod   : http://TON_IP_ORACLE:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# ---- Identifiants admin PocketBase (pour npm run setup) ----
PB_ADMIN_EMAIL=admin@exemple.com
PB_ADMIN_PASSWORD=votre_mot_de_passe_admin

# ---- Infrastructure serveur (démarrage des instances) ----

# Chemin vers le binaire PocketBase (installé par install-server.sh)
PB_BINARY_PATH=/usr/local/bin/pocketbase

# Dossier de données des projets
PB_DATA_DIR=/var/haven/projects

# Interface réseau d'écoute
PB_BIND_HOST=0.0.0.0

# IP publique ou domaine du serveur (apparaît dans les URLs des projets)
PB_PUBLIC_HOST=localhost
